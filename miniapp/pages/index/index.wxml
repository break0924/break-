<view class="page">
  <view class="hero card">
    <text class="eyebrow">德州扑克好友局</text>
    <text class="title">扫码进房，一起娱乐</text>
    <text class="sub">创建房间、邀请好友、实时同步牌局状态。</text>

    <view class="field">
      <text class="label">服务器地址</text>
      <input value="{{apiBase}}" placeholder="例如：http://192.168.0.106:8787" bindinput="onApiBaseInput" />
      <view class="row compact">
        <button size="mini" bindtap="saveApiBase">保存地址</button>
      </view>
    </view>

    <view class="field">
      <text class="label">昵称</text>
      <input value="{{name}}" placeholder="例如：阿强" bindinput="onNameInput" maxlength="20" />
    </view>

    <view class="field">
      <text class="label">房间号</text>
      <input value="{{roomId}}" placeholder="创建后或扫码进入" bindinput="onRoomInput" maxlength="12" />
    </view>

    <view class="row">
      <button type="primary" bindtap="createRoom">创建房间</button>
      <button bindtap="joinRoom">加入房间</button>
    </view>

    <view wx:if="{{roomId}}" class="share-box">
      <text>房间号：{{roomId}}</text>
      <button size="mini" bindtap="shareRoom">分享给朋友</button>
    </view>
  </view>

  <view class="card table-card" wx:if="{{room}}">
    <view class="head">
      <text class="section">牌局</text>
      <text class="badge">{{room.status === 'playing' ? '进行中' : '等待中'}}</text>
    </view>

    <view class="message">{{room.message}}</view>

    <view class="stats">
      <view><text>底池</text><text class="strong">{{room.pot}}</text></view>
      <view><text>阶段</text><text class="strong">{{room.phaseLabel}}</text></view>
      <view><text>当前行动</text><text class="strong">{{room.turnPlayer || '-'}}</text></view>
    </view>

    <view class="block">
      <text class="label">公共牌</text>
      <view class="cards">
        <block wx:for="{{room.community}}" wx:key="*this">
          <view class="card-chip">{{item}}</view>
        </block>
      </view>
    </view>

    <view class="block">
      <text class="label">你的手牌</text>
      <view class="cards">
        <block wx:for="{{myCards}}" wx:key="*this">
          <view class="card-chip">{{item}}</view>
        </block>
      </view>
    </view>

    <view class="actions">
      <button bindtap="startRoom">开局</button>
      <button bindtap="check">过牌</button>
      <button bindtap="call">跟注</button>
      <button bindtap="raise">加注 +20</button>
      <button bindtap="fold">弃牌</button>
    </view>
  </view>

  <view class="card players-card" wx:if="{{room}}">
    <view class="head">
      <text class="section">玩家</text>
      <text class="badge">{{room.roomId}}</text>
    </view>
    <block wx:for="{{room.players}}" wx:key="id">
      <view class="player {{room.turnIndex === index ? 'turn' : ''}}">
        <view>
          <text class="name">{{item.name}}{{item.id === playerId ? '（你）' : ''}}</text>
          <text class="small">{{item.lastAction || '等待中'}}</text>
        </view>
        <view class="right">
          <text>{{item.chips}} 筹码</text>
          <text class="small">{{item.folded ? '已弃牌' : '下注 ' + item.bet}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
