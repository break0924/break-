.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0;
}

.vs {
  color: #0f766e;
  font-weight: 700;
}

.info {
  color: #475569;
  font-size: 26rpx;
}

.analysis {
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.title {
  margin-bottom: 12rpx;
  font-weight: 700;
}
