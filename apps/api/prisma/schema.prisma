generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELED
}

enum OddsMarket {
  WIN_DRAW_LOSE
  HANDICAP_WIN_DRAW_LOSE
  TOTAL_GOALS
  SCORE
  HALF_FULL_TIME
}

enum SelectionType {
  HOME_WIN
  DRAW
  AWAY_WIN
  HOME_HANDICAP_WIN
  HANDICAP_DRAW
  AWAY_HANDICAP_WIN
  TOTAL_0
  TOTAL_1
  TOTAL_2
  TOTAL_3
  TOTAL_4
  TOTAL_5
  TOTAL_6
  TOTAL_7_PLUS
  SCORE_OTHER
  HALF_FULL_OTHER
}

enum SimulationMode {
  SINGLE
  PARLAY
}

enum AiAnalysisStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  REVIEWER
}

model Team {
  id          String   @id @default(cuid())
  fifaCode    String?  @unique
  name        String
  nameEn      String?
  groupName   String?
  flagUrl     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeMatches Match[] @relation("HomeTeamMatches")
  awayMatches Match[] @relation("AwayTeamMatches")

  @@index([groupName])
  @@index([isActive])
}

model Match {
  id             String      @id @default(cuid())
  matchNo        String      @unique
  stage          MatchStage
  groupName      String?
  kickoffAt      DateTime
  venue          String?
  status         MatchStatus @default(SCHEDULED)
  homeTeamId     String
  awayTeamId     String
  homeScore      Int?
  awayScore      Int?
  extraTimeScore String?
  penaltyScore   String?
  resultNote     String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  homeTeam          Team               @relation("HomeTeamMatches", fields: [homeTeamId], references: [id])
  awayTeam          Team               @relation("AwayTeamMatches", fields: [awayTeamId], references: [id])
  oddsSnapshots     OddsSnapshot[]
  simulationItems   SimulationItem[]
  prizeSelections   PrizeSelection[]
  aiAnalyses        AiAnalysis[]

  @@index([kickoffAt])
  @@index([stage])
  @@index([groupName])
  @@index([status])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model OddsSnapshot {
  id          String        @id @default(cuid())
  matchId     String
  market      OddsMarket
  selection   SelectionType
  odds        Decimal       @db.Decimal(10, 4)
  source      String?
  capturedAt  DateTime      @default(now())
  isLatest    Boolean       @default(true)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  match     Match      @relation(fields: [matchId], references: [id])
  createdBy AdminUser? @relation(fields: [createdById], references: [id])

  @@index([matchId, market, selection])
  @@index([matchId, isLatest])
  @@index([capturedAt])
}

model SimulationPlan {
  id                 String         @id @default(cuid())
  visitorKey         String?
  name               String?
  mode               SimulationMode @default(SINGLE)
  stake              Decimal        @db.Decimal(12, 2)
  multiple           Int            @default(1)
  estimatedPrizeMin  Decimal        @db.Decimal(12, 2)
  estimatedPrizeMax  Decimal        @db.Decimal(12, 2)
  riskNoticeAccepted Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items SimulationItem[]

  @@index([visitorKey])
  @@index([createdAt])
}

model SimulationItem {
  id          String        @id @default(cuid())
  planId      String
  matchId     String
  market      OddsMarket
  selection   SelectionType
  odds        Decimal       @db.Decimal(10, 4)
  createdAt   DateTime      @default(now())

  plan  SimulationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  match Match          @relation(fields: [matchId], references: [id])

  @@index([planId])
  @@index([matchId])
}

model PrizeCalculation {
  id                String         @id @default(cuid())
  visitorKey        String?
  mode              SimulationMode
  stake             Decimal        @db.Decimal(12, 2)
  multiple          Int            @default(1)
  estimatedPrizeMin Decimal        @db.Decimal(12, 2)
  estimatedPrizeMax Decimal        @db.Decimal(12, 2)
  formula           String?
  createdAt         DateTime       @default(now())

  selections PrizeSelection[]

  @@index([visitorKey])
  @@index([createdAt])
}

model PrizeSelection {
  id            String        @id @default(cuid())
  calculationId String
  matchId       String?
  market        OddsMarket
  selection     SelectionType
  odds          Decimal       @db.Decimal(10, 4)
  createdAt     DateTime      @default(now())

  calculation PrizeCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  match       Match?           @relation(fields: [matchId], references: [id])

  @@index([calculationId])
  @@index([matchId])
}

model AiAnalysis {
  id             String           @id @default(cuid())
  matchId         String
  status          AiAnalysisStatus @default(DRAFT)
  title           String?
  summary         String
  tacticalNotes   String?
  injuryNotes     String?
  riskLevel       RiskLevel        @default(MEDIUM)
  confidence      Decimal?         @db.Decimal(5, 4)
  modelName       String?
  promptVersion   String?
  rawInputHash    String?
  reviewerNote    String?
  generatedById   String?
  reviewedById    String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  match       Match      @relation(fields: [matchId], references: [id])
  generatedBy AdminUser? @relation("GeneratedAnalyses", fields: [generatedById], references: [id])
  reviewedBy  AdminUser? @relation("ReviewedAnalyses", fields: [reviewedById], references: [id])

  @@index([matchId, status])
  @@index([publishedAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String?
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  oddsSnapshots      OddsSnapshot[]
  generatedAnalyses  AiAnalysis[]  @relation("GeneratedAnalyses")
  reviewedAnalyses   AiAnalysis[]  @relation("ReviewedAnalyses")
  auditLogs          AuditLog[]
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model WorldCupTeam {
  id             String   @id
  fifaCode       String?  @unique
  name           String
  nameEn         String
  countryCode    String?
  confederation  String?
  qualification  String?
  groupId        String?
  seedSlot       String?
  flagUrl        String?
  imageUrl       String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  players WorldCupPlayer[]
  group   WorldCupGroup?  @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([countryCode])
  @@index([confederation])
}

model WorldCupPlayer {
  id             String   @id
  teamId         String
  name           String
  nameEn         String?
  shirtNumber    Int?
  position       String?
  club           String?
  birthDate      DateTime?
  nationality    String?
  flagUrl        String?
  imageUrl       String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team WorldCupTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([position])
}

model WorldCupGroup {
  id             String   @id
  name           String
  groupCode      String   @unique
  imageUrl       String?
  flagUrl        String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teams   WorldCupTeam[]
  matches WorldCupMatch[]
}

model WorldCupMatch {
  id             String   @id
  matchNo        Int      @unique
  stage          String
  groupId        String?
  homeTeamId     String?
  awayTeamId     String?
  homeSlot       String?
  awaySlot       String?
  kickoffAt      DateTime?
  stadiumId      String?
  hostCityId     String?
  status         String   @default("SCHEDULED")
  imageUrl       String?
  flagUrl        String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group    WorldCupGroup? @relation(fields: [groupId], references: [id])
  stadium  WorldCupStadium? @relation(fields: [stadiumId], references: [id])
  hostCity WorldCupHostCity? @relation(fields: [hostCityId], references: [id])

  @@index([stage])
  @@index([groupId])
  @@index([stadiumId])
  @@index([hostCityId])
  @@index([kickoffAt])
}

model WorldCupStadium {
  id             String   @id
  name           String
  fifaName       String?
  hostCityId     String
  countryCode    String
  capacity       Int?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  imageUrl       String?
  flagUrl        String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hostCity WorldCupHostCity @relation(fields: [hostCityId], references: [id])
  matches  WorldCupMatch[]

  @@index([hostCityId])
  @@index([countryCode])
}

model WorldCupHostCity {
  id             String   @id
  name           String
  country        String
  countryCode    String
  region         String?
  timezone       String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  imageUrl       String?
  flagUrl        String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stadiums WorldCupStadium[]
  matches  WorldCupMatch[]

  @@index([countryCode])
}

model WorldCupHistory {
  id             String   @id
  year           Int      @unique
  host           String
  champion       String?
  runnerUp       String?
  thirdPlace     String?
  teamsCount     Int?
  imageUrl       String?
  flagUrl        String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([champion])
}

model WorldCupFact {
  id             String   @id
  category       String
  title          String
  content        String
  imageUrl       String?
  flagUrl        String?
  introduction   String
  sourceUrl      String?
  isOfficial     Boolean  @default(false)
  lastVerifiedAt DateTime
  raw            Json?
  rag            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}
